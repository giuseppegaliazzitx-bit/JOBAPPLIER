{
  "name": "autoapply",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint apps packages fixtures",
    "db:migrate": "pnpm --filter @autoapply/db migrate",
    "dev": "pnpm --filter @autoapply/server --filter @autoapply/web --parallel dev",
    "dev:server": "pnpm --filter @autoapply/server dev",
    "dev:web": "pnpm --filter @autoapply/web dev",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
