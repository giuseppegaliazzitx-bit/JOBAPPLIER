# Copy to `.env` in the repo root or in apps/server.
# Paths are resolved at runtime. Leave blank to use the defaults.

# Directory for SQLite, documents, and screenshots. Default: ~/.autoapply
AUTOAPPLY_HOME=

# Override the database file. Default: $AUTOAPPLY_HOME/autoapply.db
AUTOAPPLY_DB=

HOST=127.0.0.1
PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173

FETCH_TIMEOUT_MS=15000
# FETCH_USER_AGENT=

# SpaceXAI (xAI). Leave blank to keep the happy path model-free.
# XAI_API_KEY=
# AI_RUN_TOKEN_CEILING=50000
# AI_DAY_SPEND_USD=2
