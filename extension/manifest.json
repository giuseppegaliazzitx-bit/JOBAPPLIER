{
  "manifest_version": 3,
  "name": "Autoapply",
  "version": "0.10.0",
  "description": "Apply with your Autoapply profile from any posting page.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ]
}
